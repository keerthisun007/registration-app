<?xml version="1.0" encoding="UTF-8"?>
<!-- 
  [Maven / Build Tool]
  USE: pom.xml (Project Object Model) is the central configuration file for Apache Maven.
  WHY: Manages project dependencies, Java versions, plugins, and handles compilation and packaging.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 
      [Spring Boot Starter Parent]
      USE: Inherits default dependency versions, plugin configurations, and compiler defaults from Spring Boot.
      WHY: Eliminates the need to manually specify compatible versions for each individual library.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- [Project Coordinates] Defines the unique identity of this project -->
    <groupId>com.keerthi</groupId>
    <artifactId>registration-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>registration-backend</name>
    <description>Registration Form Backend</description>

    <!-- [Java Version] Targets Java 17 LTS -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!-- 
          [Spring Boot / Spring Web]
          USE: Provides embedded Apache Tomcat server, Spring MVC, REST controllers, and Jackson JSON mapper.
          WHY: Needed to expose HTTP endpoints (/api/users/...) and receive/send JSON payloads.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 
          [Hibernate / Spring Data JPA]
          USE: Spring Data JPA + Hibernate (ORM - Object Relational Mapping) + HikariCP connection pool.
          WHY: Maps Java classes (User.java) to database tables ('users') and generates SQL queries automatically.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 
          [MySQL / JDBC Driver]
          USE: Official MySQL Connector/J JDBC database driver.
          WHY: Enables Java applications to communicate over TCP/IP with the MySQL database server.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 
          [Jakarta Bean Validation / Hibernate Validator]
          USE: Input validation framework providing annotations (@NotBlank, @Email, @Size, @Pattern).
          WHY: Validates form input in the DTO before data reaches database, returning clear error messages.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 
          [Spring Security / BCrypt Crypto]
          USE: Standalone Spring Security cryptographic module providing BCryptPasswordEncoder.
          WHY: Hashes passwords securely with a salt so plain text passwords are never stored in the database.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 
          [Spring Boot Actuator]
          USE: Exposes production-ready monitoring endpoints (/actuator/health, /actuator/metrics).
          WHY: Enables cloud platforms (Docker, Kubernetes, Render) to monitor uptime and health probes.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 
          [Flyway Database Migrations]
          USE: Version-controlled, repeatable SQL database schema migrations.
          WHY: Replaces unstable 'hibernate.ddl-auto=update' with deterministic, production-safe migrations.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 
          [JUnit 5 & Mockito / Spring Boot Test]
          USE: Testing framework for writing automated unit and integration tests.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 
          [H2 In-Memory Database]
          USE: Lightweight in-memory database used exclusively for automated test suites.
          WHY: Allows unit and integration tests to run fast in CI/CD without needing a live MySQL server.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- 
              [Spring Boot Maven Plugin]
              USE: Packages the application into an executable JAR containing embedded Tomcat,
                   and provides the '.\mvnw spring-boot:run' command to run the project.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>